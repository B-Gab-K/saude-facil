APP_ENV=staging
NODE_ENV=production
APP_IMAGE=saude-facil:local
APP_UID=1000
APP_GID=1000
CONFIG_FILE=./config/staging.env
SECRETS_DIR=./secrets/staging
POSTGRES_DB=saude_facil_staging
BIND_ADDRESS=127.0.0.1
APP_PORT=3443
PORT=3001
FRONTEND_ORIGINS=https://homologacao.example.invalid
NOTIFICATION_MODE=disabled
SMTP_PASSWORD_FILE=/run/secrets/smtp_password
NOTIFICATION_ALLOWLIST=
