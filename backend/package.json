{
  "name": "saude-facil-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "node --env-file-if-exists=.env -r ts-node/register src/main.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "admin:bootstrap": "node --env-file-if-exists=.env dist/cli/bootstrap-admin.js",
    "test:unit": "npm run build && node --test test/*.unit.test.js",
    "test:integration": "npm run build && node --test test/*.integration.test.js",
    "test:e2e": "npm run build && playwright test",
    "test:backup": "node --test test/backup.integration.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "nodemailer": "^10.6.0",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.21.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
