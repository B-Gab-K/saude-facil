DATABASE_URL="postgresql://saude:saude@localhost:55432/saude_facil?schema=public"
PORT=3001
NODE_ENV=development
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:8000,http://127.0.0.1:8000
# Gere DUAS chaves diferentes com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Guarde fora do Git. Não há chave padrão. A perda da chave impede ler os dados.
DATA_ENCRYPTION_KEY=
LOOKUP_HMAC_KEY=
# Em produção: NODE_ENV=production e origens HTTPS. TLS direto é o padrão.
# TLS_TERMINATION=direct
# TLS_CERT_PATH=/caminho/seguro/cert.pem
# TLS_KEY_PATH=/caminho/seguro/key.pem
# Em hospedagem que termina HTTPS e isola o HTTP interno, use TLS_TERMINATION=proxy.
# No Render a origem é derivada de RENDER_EXTERNAL_URL, salvo FRONTEND_ORIGINS explícito.
# As chaves também aceitam base64 canônico de 32 bytes, usado pelo gerador do Render.
# Demonstração exige APP_ENV=staging e banco separado; nunca habilitar na operação real.
DEMO_MODE=false
# SEED_DEMO=false
# DEMO_ADMIN_PASSWORD_FILE=/caminho/seguro/demo_admin_password
# DEMO_PATIENT_PASSWORD_FILE=/caminho/seguro/demo_patient_password
# DEMO_STAFF_PASSWORD_FILE=/caminho/seguro/demo_staff_password
# Configure somente após aprovação institucional do prazo e do escopo descrito em docs/SEGURANCA_E_DADOS.md.
# RETENTION_DAYS=
# RETENTION_POLICY_REFERENCE=
# Avisos: disabled por padrão. capture só para SMTP local; smtp exige credenciais e TLS.
NOTIFICATION_MODE=disabled
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_FROM=
# SMTP_PASSWORD_FILE=/caminho/seguro/smtp_password
# NOTIFICATION_ALLOWLIST=pessoa-de-teste@example.test
