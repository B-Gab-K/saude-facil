DATABASE_URL="postgresql://saude:saude@localhost:55432/saude_facil?schema=public"
PORT=3001
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:8000,http://127.0.0.1:8000
# Gere DUAS chaves diferentes com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Guarde fora do Git. Não há chave padrão. A perda da chave impede ler os dados.
DATA_ENCRYPTION_KEY=
LOOKUP_HMAC_KEY=
# Em produção são obrigatórios: NODE_ENV=production, origens HTTPS e os arquivos TLS.
# TLS_CERT_PATH=/caminho/seguro/cert.pem
# TLS_KEY_PATH=/caminho/seguro/key.pem
# Configure somente após aprovação institucional do prazo e do escopo descrito em docs/SEGURANCA_E_DADOS.md.
# RETENTION_DAYS=
# RETENTION_POLICY_REFERENCE=
